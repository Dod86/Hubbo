{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dod86.github.io/Hubbo/catalog/contracts/manifest-v1.schema.json",
  "title": "Hubbo catalog manifest v1",
  "type": "object",
  "required": ["catalogVersion", "schemaVersion", "generatedAt", "minAppVersion", "catalogUrl", "sha256"],
  "properties": {
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "minAppVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "catalogUrl": { "type": "string", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
